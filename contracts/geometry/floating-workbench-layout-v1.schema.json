{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contam-studio.local/contracts/floating-workbench-layout-v1.schema.json",
  "title": "CONTAM Studio Floating Workbench Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theme", "viewport", "last_focused_panel", "panels"],
  "properties": {
    "schema_version": { "const": "floating_workbench_layout.v1" },
    "theme": { "enum": ["engineering-blueprint", "architectural-paper", "night-laboratory"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 240, "maximum": 16384 }
      }
    },
    "last_focused_panel": { "type": ["string", "null"] },
    "panels": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "visible", "collapsed", "placement", "dock", "x", "y", "width", "height", "z_order"],
        "properties": {
          "id": { "enum": ["level-zones", "modeling-tools", "layers", "inspector", "command-status", "evidence", "theme-picker"] },
          "visible": { "type": "boolean" },
          "collapsed": { "type": "boolean" },
          "placement": { "enum": ["floating", "docked"] },
          "dock": { "enum": ["none", "left", "right", "top", "bottom"] },
          "x": { "type": "integer", "minimum": 0, "maximum": 16384 },
          "y": { "type": "integer", "minimum": 0, "maximum": 16384 },
          "width": { "type": "integer", "minimum": 160, "maximum": 4096 },
          "height": { "type": "integer", "minimum": 40, "maximum": 4096 },
          "z_order": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
