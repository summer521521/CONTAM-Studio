{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for controlled PRJ open, reversible volume drafts, copy export, result extraction, and active revision runs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-select-and-read-prj-zones",
    "allow-plan-zone-volume-patch",
    "allow-apply-zone-volume-patch-to-draft",
    "allow-undo-project-draft",
    "allow-redo-project-draft",
    "allow-export-active-project-draft-copy",
    "allow-select-and-extract-zone-air-state",
    "allow-extract-active-run-zone-air-state",
    "allow-export-active-zone-air-state-csv",
    "allow-run-active-contam-project"
  ]
}
