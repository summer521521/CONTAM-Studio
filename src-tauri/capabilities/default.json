{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for controlled PRJ workflows and the read-only Codex App Server assistant.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-select-and-read-prj-zones",
    "allow-plan-zone-volume-patch",
    "allow-apply-zone-volume-patch-to-draft",
    "allow-undo-project-draft",
    "allow-redo-project-draft",
    "allow-export-active-project-draft-copy",
    "allow-select-and-extract-zone-air-state",
    "allow-extract-active-run-zone-air-state",
    "allow-export-active-zone-air-state-csv",
    "allow-run-active-contam-project",
    "allow-prepare-simulation-plan",
    "allow-approve-and-run-simulation-plan",
    "allow-select-and-import-attachments",
    "allow-list-attachments",
    "allow-set-attachment-ai-selection",
    "allow-preview-attachment-evidence",
    "allow-remove-studio-attachment",
    "allow-probe-codex-app-server",
    "allow-install-official-codex-cli",
    "allow-connect-codex-app-server",
    "allow-refresh-codex-account",
    "allow-preview-ai-context",
    "allow-start-readonly-ai-turn",
    "allow-load-ai-conversation-archive",
    "allow-set-ai-conversation-archive-enabled",
    "allow-delete-ai-conversation-archive-entry",
    "allow-clear-ai-conversation-archive-for-zone",
    "allow-clear-all-ai-conversation-archive",
